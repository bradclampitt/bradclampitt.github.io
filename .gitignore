# macOS system files
.DS_Store

# Node modules
node_modules/

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files (if any)
.env
.env.local

# Optional: if you create build folders later
dist/
 
# Python virtualenvs and caches
venv/
venv3/
admin/venv/
__pycache__/
*.py[cod]

# Production databases (contain real data - NOT for GitHub)
admin/database/unified.sqlite
*.sqlite
!admin/database/demo.sqlite  # Allow demo database for GitHub

# Log files
*.log
admin/*.log

# Editor/IDE files
.vscode/
.idea/

# Built assets (can be generated by CI or during local dev)
assets/css/tailwind-built.css

# Blog generated pages
# Archive folder contains old generator attempts and is not needed on GitHub Pages.
# We keep it local-only to reduce repository noise and size.
blog/archive/
