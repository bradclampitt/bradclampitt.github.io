# macOS system files
.DS_Store

# Node modules
node_modules/

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files (if any)
.env
.env.local

# Optional: if you create build folders later
dist/

# Python virtualenvs and caches
venv/
venv3/
admin/venv/
admin/.venv/
__pycache__/
*.py[cod]

# SQLite: ignore all by default; allow unified for GitHub Pages (sql.js loads it client-side)
*.sqlite
!admin/database/unified.sqlite

# Log files
*.log
admin/*.log

# Editor/IDE files
.vscode/
.idea/

# Built assets: tailwind-built.css is committed so GitHub Pages can serve it (no build step on Pages)
# assets/css/tailwind-built.css

# Blog generated pages
# Archive folder contains old generator attempts and is not needed on GitHub Pages.
# We keep it local-only to reduce repository noise and size.
blog/archive/

# Archived Items that we do not need to push to Github.
_archived/

# Development files
.specstory/*
admin/document_save_debug.txt
admin/admin.pid

# Local SpecStory history/tool metadata
.specstory/
